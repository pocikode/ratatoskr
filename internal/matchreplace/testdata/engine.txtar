"HTTP/1.1 200 OK\r\nServer: s2\r\nContent-Type: text/plain\r\nX-Dup: one\r\nx-dup: two\r\nContent-Length: 11\r\n\r\nhello world"
-- resp-header-raw-string/rules --
{"section": "RESPONSE_HEADER", "operation": "UPDATE_RAW", "matcher": {"kind": "STRING", "value": "s1"}, "term": "s2"}
-- resp-header-raw-regex/out --
"HTTP/1.1 200 OK\r\nServer: [s1]\r\nContent-Type: text/plain\r\nX-Dup: one\r\nx-dup: two\r\nContent-Length: 11\r\n\r\nhello world"
-- resp-header-raw-regex/rules --
{"section": "RESPONSE_HEADER", "operation": "UPDATE_RAW", "matcher": {"kind": "REGEX", "value": "^Server: (?P<v>.*)"}, "term": "Server: [${v}]"}
-- resp-header-value-full/in --
"HTTP/1.1 204 No Content\r\nServer: s\r\nX-A: 1\r\n\r\n"
-- resp-header-value-full/out --
"HTTP/1.1 204 No Content\r\nServer: v\r\nX-A: v\r\n\r\n"
-- resp-header-value-full/rules --
{"section": "RESPONSE_HEADER", "operation": "UPDATE_VALUE", "matcher": {"kind": "FULL", "value": ""}, "term": "v"}
-- resp-header-value-string/out --
"HTTP/1.1 200 OK\r\nServer: s1\r\nContent-Type: TEXT/plain\r\nX-Dup: one\r\nx-dup: two\r\nContent-Length: 11\r\n\r\nhello world"
-- resp-header-value-string/rules --
{"section": "RESPONSE_HEADER", "operation": "UPDATE_VALUE", "matcher": {"kind": "STRING", "value": "text"}, "term": "TEXT"}
-- resp-header-value-regex/out --
"HTTP/1.1 200 OK\r\nServer: s1\r\nContent-Type: _text/plain\r\nX-Dup: _one\r\nx-dup: _two\r\nContent-Length: 11\r\n\r\nhello world"
-- resp-header-value-regex/rules --
{"section": "RESPONSE_HEADER", "operation": "UPDATE_VALUE", "matcher": {"kind": "REGEX", "value": "^(o|t)"}, "term": "_$1"}
-- resp-header-value-name/out --
"HTTP/1.1 200 OK\r\nServer: hidden\r\nContent-Type: text/plain\r\nX-Dup: one\r\nx-dup: two\r\nContent-Length: 11\r\n\r\nhello world"
-- resp-header-value-name/rules --
{"section": "RESPONSE_HEADER", "operation": "UPDATE_VALUE", "matcher": {"kind": "NAME", "value": "server"}, "term": "hidden"}
-- resp-header-add/out --
"HTTP/1.1 200 OK\r\nServer: s1\r\nContent-Type: text/plain\r\nX-Dup: one\r\nx-dup: two\r\nContent-Length: 11\r\nX-Added: spaced\r\n\r\nhello world"
-- resp-header-add/rules --
{"section": "RESPONSE_HEADER", "operation": "ADD", "matcher": {"kind": "NAME", "value": ""}, "term": "X-Added:  spaced"}
-- resp-header-remove-full/in --
"HTTP/1.1 204 No Content\r\nServer: s\r\nX-A: 1\r\n\r\n"
-- resp-header-remove-full/out --
"HTTP/1.1 204 No Content\r\n\r\n"
-- resp-header-remove-full/rules --
{"section": "RESPONSE_HEADER", "operation": "REMOVE", "matcher": {"kind": "FULL", "value": ""}, "term": ""}
-- resp-header-remove-string/out --
"HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nX-Dup: one\r\nx-dup: two\r\nContent-Length: 11\r\n\r\nhello world"
-- resp-header-remove-string/rules --
{"section": "RESPONSE_HEADER", "operation": "REMOVE", "matcher": {"kind": "STRING", "value": "Server"}, "term": ""}
-- resp-header-remove-regex/out --
"HTTP/1.1 200 OK\r\nServer: s1\r\nContent-Type: text/plain\r\nX-Dup: one\r\nContent-Length: 11\r\n\r\nhello world"
-- resp-header-remove-regex/rules --
{"section": "RESPONSE_HEADER", "operation": "REMOVE", "matcher": {"kind": "REGEX", "value": "(?i)^x-dup: t"}, "term": ""}
-- resp-header-remove-name/out --
"HTTP/1.1 200 OK\r\nServer: s1\r\nContent-Type: text/plain\r\nContent-Length: 11\r\n\r\nhello world"
-- resp-header-remove-name/rules --
{"section": "RESPONSE_HEADER", "operation": "REMOVE", "matcher": {"kind": "NAME", "value": "x-DUP"}, "term": ""}
-- resp-body-full/out --
"HTTP/1.1 200 OK\r\nServer: s1\r\nContent-Type: text/plain\r\nX-Dup: one\r\nx-dup: two\r\nContent-Length: 10\r\n\r\n<b>new</b>"
-- resp-body-full/rules --
{"section": "RESPONSE_BODY", "operation": "UPDATE_RAW", "matcher": {"kind": "FULL", "value": ""}, "term": "<b>new</b>"}
-- resp-body-string/out --
"HTTP/1.1 200 OK\r\nServer: s1\r\nContent-Type: text/plain\r\nX-Dup: one\r\nx-dup: two\r\nContent-Length: 11\r\n\r\nhell0 w0rld"
-- resp-body-string/rules --
{"section": "RESPONSE_BODY", "operation": "UPDATE_RAW", "matcher": {"kind": "STRING", "value": "o"}, "term": "0"}
-- resp-body-regex/out --
"HTTP/1.1 200 OK\r\nServer: s1\r\nContent-Type: text/plain\r\nX-Dup: one\r\nx-dup: two\r\nContent-Length: 11\r\n\r\nelloh orldw"
-- resp-body-regex/rules --
{"section": "RESPONSE_BODY", "operation": "UPDATE_RAW", "matcher": {"kind": "REGEX", "value": "(\\w)(\\w+)"}, "term": "$2$1"}
-- resp-body-close-delimited-gets-length/in --
"HTTP/1.1 200 OK\r\n\r\naaa"
-- resp-body-close-delimited-gets-length/out --
"HTTP/1.1 200 OK\r\nContent-Length: 3\r\n\r\nbbb"
-- resp-body-close-delimited-gets-length/rules --
{"section": "RESPONSE_BODY", "operation": "UPDATE_RAW", "matcher": {"kind": "STRING", "value": "a"}, "term": "b"}
-- resp-body-head-answer-unchanged/in --
"HTTP/1.1 200 OK\r\nContent-Length: 50\r\n\r\n"
-- resp-body-head-answer-unchanged/out --
"HTTP/1.1 200 OK\r\nContent-Length: 50\r\n\r\n"
-- resp-body-head-answer-unchanged/req --
"HEAD / HTTP/1.1\r\nHost: a\r\n\r\n"
-- resp-body-head-answer-unchanged/rules --
{"section": "RESPONSE_BODY", "operation": "UPDATE_RAW", "matcher": {"kind": "FULL", "value": ""}, "term": "x"}
-- resp-body-chunked-trailer/in --
"HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\nTrailer: X-T\r\n\r\n1\r\na\r\n1\r\nb\r\n0\r\nX-T: 1\r\n\r\n"
-- resp-body-chunked-trailer/out --
"HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\nTrailer: X-T\r\n\r\n2\r\naB\r\n0\r\nX-T: 1\r\n\r\n"
-- resp-body-chunked-trailer/rules --
{"section": "RESPONSE_BODY", "operation": "UPDATE_RAW", "matcher": {"kind": "STRING", "value": "b"}, "term": "B"}
-- first-line-broken-skipped-later-applies/out --
"POST /a/b.js?x=1&y=2&x=3 HTTP/1.1\r\nHost: example.com\r\nUser-Agent: test\r\nAccept: */*\r\nX-Dup: one\r\nx-dup: two\r\nContent-Length: 11\r\nX-B: 1\r\n\r\nhello world"
-- first-line-broken-skipped-later-applies/rules --
{"section": "REQUEST_FIRST_LINE", "operation": "UPDATE_RAW", "matcher": {"kind": "FULL", "value": ""}, "term": "garbage"}
{"section": "REQUEST_HEADER", "operation": "ADD", "matcher": {"kind": "FULL", "value": ""}, "term": "X-B: 1"}
-- content-length-larger-skipped/out --
"POST /a/b.js?x=1&y=2&x=3 HTTP/1.1\r\nHost: example.com\r\nUser-Agent: test\r\nAccept: */*\r\nX-Dup: one\r\nx-dup: two\r\nContent-Length: 11\r\n\r\nhello world"
-- content-length-larger-skipped/rules --
{"section": "REQUEST_HEADER", "operation": "UPDATE_RAW", "matcher": {"kind": "STRING", "value": "Content-Length: 11"}, "term": "Content-Length: 50"}
-- content-length-smaller-kept-with-trailing-bytes/out --
"POST /a/b.js?x=1&y=2&x=3 HTTP/1.1\r\nHost: example.com\r\nUser-Agent: test\r\nAccept: */*\r\nX-Dup: one\r\nx-dup: two\r\nContent-Length: 5\r\n\r\nhell0 world"
-- content-length-smaller-kept-with-trailing-bytes/rules --
{"section": "REQUEST_HEADER", "operation": "UPDATE_RAW", "matcher": {"kind": "STRING", "value": "Content-Length: 11"}, "term": "Content-Length: 5"}
{"section": "REQUEST_BODY", "operation": "UPDATE_RAW", "matcher": {"kind": "STRING", "value": "o"}, "term": "0"}
-- condition-sees-earlier-rule/out --
"POST /a/b.js?x=1&y=2&x=3 HTTP/1.1\r\nHost: example.com\r\nUser-Agent: test\r\nAccept: */*\r\nX-Dup: one\r\nx-dup: two\r\nContent-Length: 11\r\nX-A: 1\r\nX-B: 2\r\n\r\nhello world"
-- condition-sees-earlier-rule/rules --
{"section": "REQUEST_HEADER", "operation": "ADD", "matcher": {"kind": "FULL", "value": ""}, "term": "X-A: 1"}
{"section": "REQUEST_HEADER", "operation": "ADD", "matcher": {"kind": "FULL", "value": ""}, "term": "X-B: 2", "condition": "req.header[\"X-A\"].eq:\"1\""}
-- condition-false/out --
"POST /a/b.js?x=1&y=2&x=3 HTTP/1.1\r\nHost: example.com\r\nUser-Agent: test\r\nAccept: */*\r\nX-Dup: one\r\nx-dup: two\r\nContent-Length: 11\r\n\r\nhello world"
-- condition-false/rules --
{"section": "REQUEST_HEADER", "operation": "ADD", "matcher": {"kind": "FULL", "value": ""}, "term": "X-B: 2", "condition": "req.method.eq:\"GET\""}
-- resp-clause-false-on-request/out --
"POST /a/b.js?x=1&y=2&x=3 HTTP/1.1\r\nHost: example.com\r\nUser-Agent: test\r\nAccept: */*\r\nX-Dup: one\r\nx-dup: two\r\nContent-Length: 11\r\n\r\nhello world"
-- resp-clause-false-on-request/rules --
{"section": "REQUEST_HEADER", "operation": "ADD", "matcher": {"kind": "FULL", "value": ""}, "term": "X-B: 2", "condition": "resp.code.eq:0 OR resp.raw.cont:\"\""}
-- not-resp-clause-true-on-request/out --
"POST /a/b.js?x=1&y=2&x=3 HTTP/1.1\r\nHost: example.com\r\nUser-Agent: test\r\nAccept: */*\r\nX-Dup: one\r\nx-dup: two\r\nContent-Length: 11\r\nX-B: 2\r\n\r\nhello world"
-- not-resp-clause-true-on-request/rules --
{"section": "REQUEST_HEADER", "operation": "ADD", "matcher": {"kind": "FULL", "value": ""}, "term": "X-B: 2", "condition": "NOT resp.code.eq:0"}
-- response-condition-reads-request/out --
"HTTP/1.1 200 OK\r\nServer: s1\r\nContent-Type: text/plain\r\nX-Dup: one\r\nx-dup: two\r\nContent-Length: 11\r\nX-B: 2\r\n\r\nhello world"
-- response-condition-reads-request/req --
"POST /p HTTP/1.1\r\nHost: a\r\nContent-Length: 0\r\n\r\n"
-- response-condition-reads-request/rules --
{"section": "RESPONSE_HEADER", "operation": "ADD", "matcher": {"kind": "FULL", "value": ""}, "term": "X-B: 2", "condition": "req.method.eq:\"POST\" AND req.path.eq:\"/p\" AND resp.code.eq:200"}
-- req-host-from-host-header/out --
"POST /a/b.js?x=1&y=2&x=3 HTTP/1.1\r\nHost: example.com\r\nUser-Agent: test\r\nAccept: */*\r\nX-Dup: one\r\nx-dup: two\r\nContent-Length: 11\r\nX-B: 2\r\n\r\nhello world"
-- req-host-from-host-header/rules --
{"section": "REQUEST_HEADER", "operation": "ADD", "matcher": {"kind": "FULL", "value": ""}, "term": "X-B: 2", "condition": "req.host.eq:\"example.com\" AND req.ext.eq:\".js\" AND req.query.cont:\"y=2\""}

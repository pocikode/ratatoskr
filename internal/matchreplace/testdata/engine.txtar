"POST /a/b.js?x=1&y=2&x=3 HTTP/1.1\r\nHost: example.com\r\nUser-Agent: test\r\nAccept: */*\r\nX-Dup: one\r\nx-dup: two\r\nContent-Length: 11\r\nX-C: 3\r\n\r\nhello world"
-- preset-unknown-skipped-by-set/rules --
{"section": "REQUEST_HEADER", "operation": "ADD", "matcher": {"kind": "FULL", "value": ""}, "term": "X-B: 2", "condition": "preset:nope"}
{"section": "REQUEST_HEADER", "operation": "ADD", "matcher": {"kind": "FULL", "value": ""}, "term": "X-C: 3"}
-- preset-row-id-skipped-by-set/out --
"POST /a/b.js?x=1&y=2&x=3 HTTP/1.1\r\nHost: example.com\r\nUser-Agent: test\r\nAccept: */*\r\nX-Dup: one\r\nx-dup: two\r\nContent-Length: 11\r\nX-C: 3\r\n\r\nhello world"
-- preset-row-id-skipped-by-set/presets --
{"name": "ids", "query": "row.id.gt:1"}
-- preset-row-id-skipped-by-set/rules --
{"section": "REQUEST_HEADER", "operation": "ADD", "matcher": {"kind": "FULL", "value": ""}, "term": "X-B: 2", "condition": "preset:ids"}

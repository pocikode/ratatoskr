"GET http://abs.example:8080/p HTTP/1.1\r\n\r\n"
-- req-host-from-absolute-target/out --
"GET http://abs.example:8080/p HTTP/1.1\r\nX-B: 2\r\n\r\n"
-- req-host-from-absolute-target/rules --
{"section": "REQUEST_HEADER", "operation": "ADD", "matcher": {"kind": "FULL", "value": ""}, "term": "X-B: 2", "condition": "req.host.eq:\"abs.example\""}
-- source-not-listed/out --
"POST /a/b.js?x=1&y=2&x=3 HTTP/1.1\r\nHost: example.com\r\nUser-Agent: test\r\nAccept: */*\r\nX-Dup: one\r\nx-dup: two\r\nContent-Length: 11\r\n\r\nhello world"
-- source-not-listed/rules --
{"section": "REQUEST_HEADER", "operation": "ADD", "matcher": {"kind": "FULL", "value": ""}, "term": "X-B: 2", "sources": ["REPLAY"]}
-- disabled-rule/out --
"POST /a/b.js?x=1&y=2&x=3 HTTP/1.1\r\nHost: example.com\r\nUser-Agent: test\r\nAccept: */*\r\nX-Dup: one\r\nx-dup: two\r\nContent-Length: 11\r\n\r\nhello world"
-- disabled-rule/rules --
{"section": "REQUEST_HEADER", "operation": "ADD", "matcher": {"kind": "FULL", "value": ""}, "term": "X-B: 2", "enabled": false}
-- preset-condition-matches/out --
"POST /a/b.js?x=1&y=2&x=3 HTTP/1.1\r\nHost: example.com\r\nUser-Agent: test\r\nAccept: */*\r\nX-Dup: one\r\nx-dup: two\r\nContent-Length: 11\r\nX-B: 2\r\n\r\nhello world"
-- preset-condition-matches/presets --
{"name": "JS files", "alias": "js", "query": "req.ext.eq:\".js\""}
-- preset-condition-matches/rules --
{"section": "REQUEST_HEADER", "operation": "ADD", "matcher": {"kind": "FULL", "value": ""}, "term": "X-B: 2", "condition": "preset:js"}

# Golden response corpus (F-NET-3). `kind` carries the request method for the
# body rules (HEAD), everything else behaves like requests.txtar.
-- 001-ok-length/kind --
response
-- 001-ok-length/wire --
"HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\nhello"

-- 002-chunked/kind --
response
-- 002-chunked/wire --
"HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n3\r\nabc\r\n0\r\n\r\n"

-- 003-head/kind --
response HEAD
-- 003-head/wire --
"HTTP/1.1 200 OK\r\nContent-Length: 42\r\n\r\n"

-- 004-no-content/kind --
response
-- 004-no-content/wire --
"HTTP/1.1 204 No Content\r\nContent-Length: 10\r\n\r\n"

-- 005-not-modified/kind --
response
-- 005-not-modified/wire --
"HTTP/1.1 304 Not Modified\r\nContent-Length: 10\r\n\r\n"

-- 006-continue/kind --
response
-- 006-continue/wire --
"HTTP/1.1 100 Continue\r\n\r\n"

-- 007-close-delimited/kind --
response
-- 007-close-delimited/wire --
"HTTP/1.0 200 OK\r\n\r\n<html></html>"

-- 008-reason-spacing/kind --
response
-- 008-reason-spacing/wire --
"HTTP/1.1 404 Not   Found\r\nContent-Length: 0\r\n\r\n"

-- 009-empty-reason/kind --
response
-- 009-empty-reason/wire --
"HTTP/1.1 200\r\nContent-Length: 0\r\n\r\n"

-- 010-http10-keep-alive/kind --
response
-- 010-http10-keep-alive/wire --
"HTTP/1.0 200 OK\r\nConnection: keep-alive\r\nContent-Length: 2\r\n\r\nok"

-- 011-bad-status/kind --
response
-- 011-bad-status/wire --
"HTTP/1.1 ABC Bad\r\n\r\n"
-- 011-bad-status/error --
malformed

-- 012-bare-lf/kind --
response
-- 012-bare-lf/wire --
"HTTP/1.1 200 OK\nContent-Length: 2\n\nhi"
-- 012-bare-lf/warnings --
bare-lf
-- 013-length-and-chunked/kind --
response
-- 013-length-and-chunked/wire --
"HTTP/1.1 200 OK\r\nContent-Length: 3\r\nTransfer-Encoding: chunked\r\n\r\n3\r\nabc\r\n0\r\n\r\n"
-- 013-length-and-chunked/warnings --
content-length-with-transfer-encoding
-- 014-informational-pipelined/kind --
response
-- 014-informational-pipelined/wire --
"HTTP/1.1 100 Continue\r\n\r\nHTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nhi"
-- 014-informational-pipelined/raw --
"HTTP/1.1 100 Continue\r\n\r\n"
-- 014-informational-pipelined/rest --
"HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nhi"
-- 015-head-with-chunked/kind --
response HEAD
-- 015-head-with-chunked/wire --
"HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n"

-- 016-chunked-trailer/kind --
response
-- 016-chunked-trailer/wire --
"HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n2\r\nok\r\n0\r\nX-Sum: 1\r\n\r\n"

-- 017-obs-fold/kind --
response
-- 017-obs-fold/wire --
"HTTP/1.1 200 OK\r\nX-Multi: a\r\n b\r\nContent-Length: 2\r\n\r\nok"
-- 017-obs-fold/warnings --
obs-fold
-- 018-teapot/kind --
response
-- 018-teapot/wire --
"HTTP/1.1 418 I'm a teapot\r\nContent-Length: 0\r\n\r\n"

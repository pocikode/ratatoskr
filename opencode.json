{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "allow",
    "webfetch": "allow",
    "bash": {
      "*": "ask",
      "make *": "allow",
      "go *": "allow",
      "gofmt *": "allow",
      "golangci-lint *": "allow",
      "bun *": "allow",
      "bunx *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git add*": "allow",
      "git commit*": "allow",
      "git fetch*": "allow",
      "git rebase*": "allow",
      "git switch*": "allow",
      "git checkout*": "allow",
      "git branch*": "allow",
      "git stash*": "allow",
      "git push -u origin HEAD": "allow",
      "git push origin*": "allow",
      "git remote get-url*": "allow",
      "gh pr create*": "allow",
      "gh pr view*": "allow",
      "gh pr list*": "allow",
      "gh pr checks*": "allow",
      "graphify *": "allow",
      "ls*": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "find *": "allow",
      "jq *": "allow",
      "mkdir *": "allow",
      "diff *": "allow",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git push upstream*": "deny",
      "git reset --hard*": "deny",
      "rm -rf*": "deny",
      "gh pr merge*": "deny"
    }
  }
}
